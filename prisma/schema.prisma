generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth v5 required tables) ──────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  workspaceMembers WorkspaceMember[]
  ownedWorkspaces  Workspace[]        @relation("WorkspaceOwner")
  assignedIssues   Issue[]            @relation("IssueAssignee")
  reportedIssues   Issue[]            @relation("IssueReporter")
  comments         Comment[]
  timeEntries      TimeEntry[]
  notifications    Notification[]
  reviewRequests   ReviewRequest[]
  gitConnections   GitHubConnection[]
  activityLogs     ActivityLog[]
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members        WorkspaceMember[]
  projects       Project[]
  labels         Label[]
  gitConnections GitHubConnection[]
  webhooks       Webhook[]
  notifications  Notification[]

  @@index([slug])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ─── Project ──────────────────────────────────────────────────────────────────

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  key         String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#6366f1")
  iconUrl     String?
  repoUrl     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues     Issue[]
  sprints    Sprint[]
  labels     Label[]     @relation("ProjectLabels")
  milestones Milestone[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// ─── Issue ────────────────────────────────────────────────────────────────────

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NO_PRIORITY
}

enum IssueType {
  BUG
  FEATURE
  TASK
  IMPROVEMENT
  EPIC
}

model Issue {
  id            String        @id @default(cuid())
  number        Int
  projectId     String
  sprintId      String?
  milestoneId   String?
  title         String
  description   String?       @db.Text
  status        IssueStatus   @default(BACKLOG)
  priority      IssuePriority @default(NO_PRIORITY)
  type          IssueType     @default(TASK)
  assigneeId    String?
  reporterId    String
  storyPoints   Int?
  position      Float
  dueDate       DateTime?
  closedAt      DateTime?
  parentIssueId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone    Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee     User?              @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter     User               @relation("IssueReporter", fields: [reporterId], references: [id])
  parentIssue  Issue?             @relation("ParentIssue", fields: [parentIssueId], references: [id])
  subIssues    Issue[]            @relation("ParentIssue")
  labels       IssueLabel[]
  comments     Comment[]
  timeEntries  TimeEntry[]
  linkedCommits CommitIssue[]
  linkedPRs    PullRequestIssue[]
  activityLogs ActivityLog[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([status])
}

// ─── Labels ───────────────────────────────────────────────────────────────────

model Label {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  color       String  @default("#94a3b8")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation("ProjectLabels", fields: [projectId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  @@index([workspaceId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

// ─── Comments ─────────────────────────────────────────────────────────────────

model Comment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      String    @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([issueId])
}

// ─── Sprint ───────────────────────────────────────────────────────────────────

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Sprint {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  goal        String?      @db.Text
  status      SprintStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  velocity    Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues            Issue[]
  burndownSnapshots BurndownSnapshot[]

  @@index([projectId])
}

model BurndownSnapshot {
  id              String   @id @default(cuid())
  sprintId        String
  date            DateTime @db.Date
  remainingPoints Int
  completedPoints Int
  totalPoints     Int

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, date])
  @@index([sprintId])
}

// ─── Milestone ────────────────────────────────────────────────────────────────

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

// ─── Time Tracking ────────────────────────────────────────────────────────────

model TimeEntry {
  id          String    @id @default(cuid())
  issueId     String
  userId      String
  description String?
  startedAt   DateTime
  stoppedAt   DateTime?
  duration    Int?
  createdAt   DateTime  @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([issueId])
  @@index([userId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationType {
  ISSUE_ASSIGNED
  ISSUE_MENTIONED
  ISSUE_STATUS_CHANGED
  COMMENT_ADDED
  SPRINT_STARTED
  SPRINT_COMPLETED
  PR_REVIEW_REQUESTED
  PR_MERGED
  WORKSPACE_INVITE
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  body        String?
  url         String?
  readAt      DateTime?
  actorId     String?
  entityId    String?
  entityType  String?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([workspaceId])
}

// ─── GitHub Integration ───────────────────────────────────────────────────────

model GitHubConnection {
  id             String   @id @default(cuid())
  workspaceId    String
  userId         String
  installationId String   @unique
  accountLogin   String
  accountType    String
  accessToken    String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])
  repos     GitHubRepo[]

  @@index([workspaceId])
}

model GitHubRepo {
  id            String @id @default(cuid())
  connectionId  String
  repoId        Int
  fullName      String
  defaultBranch String @default("main")

  connection   GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  commits      Commit[]
  pullRequests PullRequest[]

  @@unique([connectionId, repoId])
}

model Commit {
  id          String   @id @default(cuid())
  repoId      String
  sha         String
  message     String   @db.Text
  authorName  String
  authorEmail String
  pushedAt    DateTime
  url         String

  repo   GitHubRepo  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  issues CommitIssue[]

  @@unique([repoId, sha])
  @@index([repoId])
}

model CommitIssue {
  commitId String
  issueId  String

  commit Commit @relation(fields: [commitId], references: [id], onDelete: Cascade)
  issue  Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([commitId, issueId])
}

enum PullRequestStatus {
  OPEN
  CLOSED
  MERGED
  DRAFT
}

model PullRequest {
  id          String            @id @default(cuid())
  repoId      String
  prNumber    Int
  title       String
  body        String?           @db.Text
  status      PullRequestStatus @default(OPEN)
  authorLogin String
  headBranch  String
  baseBranch  String
  url         String
  mergedAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime
  updatedAt   DateTime

  repo           GitHubRepo         @relation(fields: [repoId], references: [id], onDelete: Cascade)
  issues         PullRequestIssue[]
  reviewRequests ReviewRequest[]

  @@unique([repoId, prNumber])
  @@index([repoId])
}

model PullRequestIssue {
  pullRequestId String
  issueId       String

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  issue       Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([pullRequestId, issueId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
}

model ReviewRequest {
  id            String       @id @default(cuid())
  pullRequestId String
  reviewerId    String
  reviewerLogin String
  status        ReviewStatus @default(PENDING)
  submittedAt   DateTime?

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id])

  @@index([pullRequestId])
  @@index([reviewerId])
}

// ─── Webhooks ─────────────────────────────────────────────────────────────────

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  secret      String
  url         String
  events      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  statusCode  Int?
  response    String?  @db.Text
  deliveredAt DateTime @default(now())
  success     Boolean

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

// ─── Activity Log ─────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  issueId   String?
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id])

  @@index([issueId])
  @@index([userId])
}
